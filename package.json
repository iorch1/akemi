{
  "name": "akemi",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:cap",
    "build:cap": "tsc -b && vite build --base=./",
    "build:cloud": "tsc -b && vite build --base=/akemi/",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "npm run build:cap && node scripts/verify-cap-bundle.mjs && npx cap sync",
    "android:open": "npx cap open android",
    "android:build": "npm run cap:sync && node scripts/android-assemble.mjs assembleDebug",
    "android:release": "npm run cap:sync && node scripts/android-assemble.mjs assembleRelease",
    "apk:stage": "node scripts/stage-android-apk.mjs",
    "ota:bundle": "npm run build:cap && node scripts/verify-cap-bundle.mjs && node scripts/publish-ota.mjs",
    "libros:ingest": "python3 scripts/ingest-robcrea-libros.py"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capawesome/capacitor-live-update": "^8.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
